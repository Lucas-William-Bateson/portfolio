---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import cv from '../../cv.json';

type System = {
  name: string;
  purpose: string;
  capabilities: string[];
  scope: string;
  evidence: string;
  url: string;
};

type Now = {
  updated: string;
  items: string[];
};

type Link = {
  label: string;
  url: string;
};

type Talk = {
  title: string;
  lang?: string;
  event: string;
  venue: string;
  with?: string;
  summary?: string;
  links: Link[];
};

type Work = {
  role: string;
  company: string;
  location?: string;
  time?: string;
  description: string;
};

type Education = {
  school: string;
  program: string;
  years: string;
  result?: string;
};

const now: Now = cv.now;
const talks: Talk[] = cv.talks;
const work: Work[] = cv.work;
const education: Education[] = cv.education;
const links: Link[] = cv.links;

const email = links.find((l) => l.url.startsWith('mailto:'))?.url.replace('mailto:', '');
const year = new Date().getFullYear();
---
<BaseLayout title={cv.name} description={cv.hero.secondary} theme={cv.dataTheme}>

  <!-- Hero -->
  <header id="hero" class="relative overflow-hidden">
    <canvas id="field" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>
    <div class="ix-container relative pt-16 md:pt-28 pb-10 md:pb-16">
      <p class="t-label text-secondary">{cv.hero.tertiary}</p>
      <h1 class="t-display-xl mt-5">{cv.name}</h1>
      <div class="grid md:grid-cols-12 gap-x-6 gap-y-10 mt-10 md:mt-14 items-end">
        <div class="md:col-span-7">
          <p class="t-lead-xl text-text max-w-[640px]">{cv.hero.secondary}</p>
          <nav aria-label="Links" class="mt-8 flex flex-wrap gap-x-8 gap-y-3 t-label text-secondary">
            {links.map((l) => (
              <a
                href={l.url}
                target={l.url.startsWith('http') ? '_blank' : undefined}
                rel="noreferrer noopener"
                class="ix-link"
              >{l.label}</a>
            ))}
          </nav>
        </div>
        <figure class="md:col-span-5 md:justify-self-end">
          <img
            src="/avatar.jpeg"
            alt={`${cv.name}, portrait`}
            width="784"
            height="1000"
            class="w-full max-w-[340px] aspect-[4/5] object-cover"
          />
        </figure>
      </div>
      <p class="mt-8 t-data text-muted">
        Behind the name: three bodies on a figure-eight orbit, integrated live in your browser.
      </p>
    </div>
  </header>

  <main class="ix-container pb-24 md:pb-32">

    <!-- Work -->
    <section id="work" class="pt-20 md:pt-28">
      <SectionHead title="Work" />
      <div class="mt-4">
        {work.map((w, i) => (
          <div class:list={['grid md:grid-cols-12 gap-x-6 gap-y-2 py-7', i > 0 && 'border-t border-border']}>
            <p class="md:col-span-3 t-data text-muted">{w.time}</p>
            <div class="md:col-span-9">
              <h3 class="t-heading text-text">{w.role}</h3>
              <p class="mt-1 text-secondary">{w.company}</p>
              <p class="mt-3 text-secondary max-w-[680px]">{w.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Talks -->
    <section id="talks" class="pt-20 md:pt-28">
      <SectionHead title="Talks" />
      <div class="mt-4">
        {talks.map((t, i) => (
          <article class:list={['grid md:grid-cols-12 gap-x-6 gap-y-2 py-7', i > 0 && 'border-t border-border']}>
            <p class="md:col-span-3 t-data text-muted">
              {t.event}<br />{t.venue}{t.with && <Fragment><br />with {t.with}</Fragment>}
            </p>
            <div class="md:col-span-9">
              <h3 lang={t.lang} class="t-heading text-text max-w-[680px]">{t.title}</h3>
              {t.summary && <p class="mt-3 text-secondary max-w-[680px]">{t.summary}</p>}
              {t.links.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-secondary">
                  {t.links.map((l) => (
                    <a href={l.url} target="_blank" rel="noreferrer noopener" class="ix-link">{l.label}</a>
                  ))}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="pt-20 md:pt-28">
      <SectionHead title="Projects" />
      <div class="mt-4">
        {cv.systems.primary.map((s: System, i: number) => (
          <article class:list={['grid md:grid-cols-12 gap-x-6 gap-y-2 py-7', i > 0 && 'border-t border-border']}>
            <p class="md:col-span-3 t-data text-muted">{s.scope}</p>
            <div class="md:col-span-9">
              <h3 class="t-heading text-text">
                <a href={s.url} target="_blank" rel="noreferrer noopener" class="ix-link">{s.name}</a>
              </h3>
              <p class="mt-3 text-secondary max-w-[680px]">{s.purpose}</p>
              <ul class="mt-3 max-w-[680px] list-disc pl-5 space-y-1 text-secondary">
                {s.capabilities.map((c: string) => (<li>{c}</li>))}
              </ul>
              <p class="mt-3 text-text max-w-[680px]">{s.evidence}</p>
            </div>
          </article>
        ))}

        {/* Smaller projects */}
        {cv.systems.foundational.map((s: System) => (
          <div class="grid md:grid-cols-12 gap-x-6 gap-y-1 py-5 border-t border-border">
            <p class="md:col-span-3 t-data text-muted">{s.scope}</p>
            <p class="md:col-span-9 text-secondary max-w-[680px]">
              <a href={s.url} target="_blank" rel="noreferrer noopener" class="ix-link text-text font-semibold">{s.name}</a>. {s.purpose}
            </p>
          </div>
        ))}
      </div>
      {/* TODO(Lucas): add kiln as a foundational entry in cv.json once the repo URL is known. */}
      <p class="mt-6 t-data text-muted">{cv.infrastructure.summary}</p>
    </section>

    <!-- Education -->
    <section id="education" class="pt-20 md:pt-28">
      <SectionHead title="Education" />
      <div class="mt-4">
        {education.map((e, i) => (
          <div class:list={['grid md:grid-cols-12 gap-x-6 gap-y-2 py-7', i > 0 && 'border-t border-border']}>
            <p class="md:col-span-3 t-data text-muted">{e.years}</p>
            <div class="md:col-span-9">
              <h3 class="t-heading text-text">{e.school}</h3>
              <p class="mt-1 text-secondary">{e.program}</p>
              {e.result && <p class="mt-2 text-text">{e.result}</p>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Now -->
    <section id="now" class="pt-20 md:pt-28">
      <SectionHead title="Now" meta={`Updated ${now.updated}`} />
      <div class="grid md:grid-cols-12 gap-x-6 mt-8">
        <ul class="md:col-start-4 md:col-span-9 max-w-[680px] list-disc pl-5 space-y-2 text-secondary">
          {now.items.map((item) => (<li>{item}</li>))}
        </ul>
      </div>
    </section>

    <!-- Contact -->
    <footer id="contact" class="pt-20 md:pt-28">
      <SectionHead title="Contact" />
      <div class="grid md:grid-cols-12 gap-x-6 mt-8">
        <div class="md:col-start-4 md:col-span-9 max-w-[680px]">
          {email && (
            <p class="t-lead"><a href={`mailto:${email}`} class="ix-link text-text">{email}</a></p>
          )}
          {cv.contact?.note && <p class="mt-3 text-secondary">{cv.contact.note}</p>}
        </div>
      </div>
      <p class="mt-16 md:mt-24 pt-4 border-t border-border t-data text-muted">{cv.name} · {cv.hero.tertiary} · {year}</p>
    </footer>
  </main>

  <script>
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- Hero: three equal masses on the figure-eight orbit (Chenciner & Montgomery), G = m = 1 ----
    function initField() {
      const canvas = document.getElementById('field') as HTMLCanvasElement | null;
      const hero = document.getElementById('hero');
      const ctx = canvas?.getContext('2d');
      if (!canvas || !hero || !ctx) return;

      const css = getComputedStyle(document.documentElement);
      const EMBER = css.getPropertyValue('--ember').trim() || '#ff6b2c';
      const INK = css.getPropertyValue('--text').trim() || '#f4eee3';

      const DT = 0.001;
      const PERIOD = 6.32591398;
      const SIM_RATE = PERIOD / 21; // one full orbit every 21 s of wall time
      const TRAIL = 420;

      const px = [0.97000436, -0.97000436, 0];
      const py = [-0.24308753, 0.24308753, 0];
      const vx = [0.466203685, 0.466203685, -0.93240737];
      const vy = [0.43236573, 0.43236573, -0.86473146];
      const ax = [0, 0, 0];
      const ay = [0, 0, 0];

      function accel() {
        ax.fill(0); ay.fill(0);
        for (let i = 0; i < 3; i++) {
          for (let j = i + 1; j < 3; j++) {
            const dx = px[j] - px[i], dy = py[j] - py[i];
            const r2 = dx * dx + dy * dy;
            const inv = 1 / (r2 * Math.sqrt(r2));
            ax[i] += dx * inv; ay[i] += dy * inv;
            ax[j] -= dx * inv; ay[j] -= dy * inv;
          }
        }
      }
      function step() {
        for (let i = 0; i < 3; i++) {
          vx[i] += ax[i] * DT * 0.5; vy[i] += ay[i] * DT * 0.5;
          px[i] += vx[i] * DT; py[i] += vy[i] * DT;
        }
        accel();
        for (let i = 0; i < 3; i++) {
          vx[i] += ax[i] * DT * 0.5; vy[i] += ay[i] * DT * 0.5;
        }
      }
      accel();

      const trails: number[][] = [[], [], []];
      let w = 0, h = 0, dpr = 1, cx = 0, cy = 0, scale = 1;

      function resize() {
        const rect = canvas!.getBoundingClientRect();
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        w = rect.width; h = rect.height;
        canvas!.width = Math.round(w * dpr);
        canvas!.height = Math.round(h * dpr);
        cx = w * 0.5;
        cy = h * 0.5;
        scale = Math.min(w * 0.42, h * 1.1);
      }

      function draw() {
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx!.clearRect(0, 0, w, h);
        ctx!.lineWidth = 1.25;
        ctx!.lineCap = 'round';
        ctx!.strokeStyle = EMBER;
        const BANDS = 14;
        for (let b = 0; b < 3; b++) {
          const t = trails[b];
          const n = t.length / 2;
          for (let k = 0; k < BANDS; k++) {
            const from = Math.floor((k / BANDS) * n);
            const to = Math.min(n - 1, Math.floor(((k + 1) / BANDS) * n));
            if (to <= from) continue;
            ctx!.globalAlpha = 0.03 + 0.55 * Math.pow((k + 1) / BANDS, 2);
            ctx!.beginPath();
            ctx!.moveTo(cx + t[from * 2] * scale, cy + t[from * 2 + 1] * scale);
            for (let i = from + 1; i <= to; i++) {
              ctx!.lineTo(cx + t[i * 2] * scale, cy + t[i * 2 + 1] * scale);
            }
            ctx!.stroke();
          }
        }
        ctx!.globalAlpha = 1;
        ctx!.fillStyle = INK;
        for (let b = 0; b < 3; b++) {
          ctx!.beginPath();
          ctx!.arc(cx + px[b] * scale, cy - py[b] * scale, 3.5, 0, Math.PI * 2);
          ctx!.fill();
        }
      }

      function record() {
        for (let b = 0; b < 3; b++) {
          trails[b].push(px[b], -py[b]);
          if (trails[b].length > TRAIL * 2) trails[b].splice(0, 2);
        }
      }

      resize();
      new ResizeObserver(() => { resize(); draw(); }).observe(canvas);

      if (reduced) {
        // Static figure: one full period drawn once, nothing moves.
        const steps = Math.round(PERIOD / DT);
        for (let s = 0; s < steps; s++) {
          step();
          if (s % 15 === 0) record();
        }
        draw();
        return;
      }

      let visible = true;
      let last = performance.now();
      let raf = 0;

      function frame(nowMs: number) {
        raf = 0;
        if (!visible || document.hidden) return;
        const elapsed = Math.min(0.05, (nowMs - last) / 1000);
        last = nowMs;
        const steps = Math.max(1, Math.round((elapsed * SIM_RATE) / DT));
        for (let s = 0; s < steps; s++) step();
        record();
        draw();
        raf = requestAnimationFrame(frame);
      }
      function start() {
        if (raf) return;
        last = performance.now();
        raf = requestAnimationFrame(frame);
      }

      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        if (visible) start();
      }).observe(hero);
      document.addEventListener('visibilitychange', () => { if (!document.hidden) start(); });
      start();
    }

    initField();
  </script>

</BaseLayout>
